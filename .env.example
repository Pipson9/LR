# 复制本文件为 .env，并填入你自己的值
#   cp .env.example .env

# ===== 对话大模型（阿里云百炼 / DashScope，OpenAI 兼容模式）=====
BAILIAN_APIKEY=your_bailian_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== LangSmith 链路追踪（可选，不用可留空）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kb-rag-demo

# ===== 本地 Embedding 模型路径 =====
# 下载 bge-small-zh-v1.5 到本地后，填写其绝对路径
# 下载地址：https://huggingface.co/BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_PATH=models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
