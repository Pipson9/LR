# 复制本文件为 .env，然后把值改成你自己的
# cp .env.example .env   （Windows: copy .env.example .env）

# 数据库连接串。
# 驱动必须是 asyncmy（异步驱动），不能用 pymysql ——
# db/database.py 用的是 create_async_engine，配同步驱动会直接报 NoSuchModuleError
DATABASE_URL=mysql+asyncmy://user:password@127.0.0.1:3306/fastapi_demo

# JWT 签名密钥。生产环境请换成随机长字符串，例如：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# JWT 签名算法
ALGORITHM=HS256

# 令牌有效期（分钟），1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
